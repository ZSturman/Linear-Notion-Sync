# Notion-Linear Sync Service Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Notion Integration Token
# Get this from: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxx

# Notion Database IDs
# Get these from the database URL: https://www.notion.so/workspace/DATABASE_ID?v=...
# The ID is the 32-character string before the ?v= parameter
NOTION_PROJECTS_DB_ID=
NOTION_MILESTONES_DB_ID=
NOTION_TASKS_DB_ID=
NOTION_AUTOMATION_LOG_DB_ID=

# Linear API Key
# Get this from: https://linear.app/settings/api
LINEAR_API_KEY=lin_api_xxxxx

# Linear Team Key (optional)
# The short team identifier like "PROJ" that prefixes issues
# If not set, will use the first available team
# LINEAR_TEAM_KEY=

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Path to SQLite database for sync state persistence
# Default: ./sync_state.db
# SYNC_STATE_PATH=./sync_state.db

# Path used by the generated n8n workflow exports for local shared state.
# This should stay inside the host-mounted ${HOME}/n8n-files volume.
# N8N_SYNC_STATE_PATH=/home/node/.n8n-files/notion-linear-sync/sync_state.json

# Logging level: DEBUG, INFO, WARNING, ERROR
# Default: INFO
# LOG_LEVEL=INFO

# Dry run mode: Set to "true" to preview changes without making them
# Default: false
# DRY_RUN=false

# Conflict resolution strategy when both systems have changes:
# - last-write-wins: Most recently modified wins (default)
# - notion-primary: Notion always wins
# - linear-primary: Linear always wins
# CONFLICT_STRATEGY=last-write-wins

# When creating Notion pages from Linear records, default the "linear sync"
# checkbox to true (so they continue to sync)
# Default: true
# IMPORT_LINEAR_SYNC_DEFAULT=true
